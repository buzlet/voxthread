#!/usr/bin/env bash
# scripts/voxemu
set -euo pipefail
SDK="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-/home/gpt/Android/Sdk}}"
ADB="$SDK/platform-tools/adb"
EMU="$SDK/emulator/emulator"
SERIAL="${VOXEMU_SERIAL:-emulator-5554}"
AVD="${VOXEMU_AVD:-voxthread-api36}"
boot_wait() {
  "$ADB" -s "$SERIAL" wait-for-device
  until [ "$("$ADB" -s "$SERIAL" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = "1" ]; do sleep 2; done
}
case "${1:-status}" in
  start)
    if ! "$ADB" -s "$SERIAL" get-state >/dev/null 2>&1; then
      sg kvm -c "nohup '$EMU' '@$AVD' -no-window -no-audio -no-boot-anim -gpu swiftshader_indirect -memory 2048 -cores 2 >/tmp/voxthread-emulator.log 2>&1 &"
    fi
    boot_wait
    "$ADB" -s "$SERIAL" shell getprop ro.build.version.release
    ;;
  stop) "$ADB" -s "$SERIAL" emu kill ;;
  status)
    "$ADB" devices -l
    "$ADB" -s "$SERIAL" shell getprop sys.boot_completed 2>/dev/null || true
    ;;
  cdp) "$ADB" -s "$SERIAL" forward tcp:9223 localabstract:chrome_devtools_remote ;;
  probe)
    url="http://10.0.2.2:8765/tests/browser/tts-probe.html?rev=$(date +%s)"
    "$ADB" -s "$SERIAL" shell am start \
      -a android.intent.action.VIEW \
      -d "$url" \
      com.android.chrome
    ;;
  adb) shift; exec "$ADB" -s "$SERIAL" "$@" ;;
  *) echo "usage: voxemu {start|stop|status|cdp|probe|adb ...}" >&2; exit 2 ;;
esac
